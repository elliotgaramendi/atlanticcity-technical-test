{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "paths": {
      "components": ["./src/components/index.ts"],
      "hooks": ["./src/hooks/index.ts"],
      "lib": ["./src/lib"],
      "src/*": ["./src/*"],
      "ui": ["./src/components/ui/index.ts"],
      "utils": ["./src/lib/utils.ts"]
    }
  },
  "include": ["src"]
}
